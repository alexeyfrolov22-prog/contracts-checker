{
  "name": "contracts-checker",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "updateContentCommand": "python3 -m pip install --user -r requirements.txt",
  "postAttachCommand": {
    "server": "python3 -m streamlit run app.py --server.headless true --server.port 8501 --server.enableCORS false --server.enableXsrfProtection false"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
